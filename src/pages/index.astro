---
import SiteLayout from '../layouts/SiteLayout.astro';
import { products } from '../data/products';

// Naive terminal highlighting: mute comment lines; wrap a leading keyword.
function highlight(src: string): string {
  return src
    .split('\n')
    .map((line) => {
      const trimmed = line.trimStart();
      if (trimmed.startsWith('//')) {
        return `<span class="c">${line}</span>`;
      }
      const m = trimmed.match(/^(var|await|IStore|builder|using|new|$color)\b/);
      if (m) {
        const kw = m[0];
        const idx = line.indexOf(kw);
        return `${line.slice(0, idx)}<span class="k">${kw}</span>${line.slice(idx + kw.length)}`;
      }
      return line;
    })
    .join('\n');
}
---

<SiteLayout>
  <!-- ============================ HERO ============================ -->
  <header class="hero" id="top">
    <div class="wrap hero__inner">
      <code class="hero__cmd">
        <span class="p-user">gumbarros</span><span class="p-path">@portfolio:~$</span>
        <span data-type="whoami"></span><span class="cursor" aria-hidden="true"></span>
      </code>
      <h1 class="hero__title">
        Gustavo Mauricio de&nbsp;Barros
      </h1>
      <p class="hero__lede">
        Software architect working the .NET ecosystem. I build the
        libraries developers reach for when a problem has a name. Each one below is the
        problem, then the one-liner that removes it.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="#products">
          <span>view products</span><span class="arrow">→</span>
        </a>
        <a class="btn btn--ghost" href="#contact">
          <span>contact</span><span class="arrow">→</span>
        </a>
      </div>
    </div>
  </header>

  <!-- ============================ PRODUCTS ============================ -->
  <section class="ledger" id="products">
    <div class="wrap ledger__head reveal">
      <code class="cmd">gumbarros@portfolio:~$ ls ./problems/ · {products.length} entries</code>
      <h2>Every .NET pain, next to the line that removes it.</h2>
    </div>

    <div class="wrap ledger__list">
      {products.map((p, i) => (
        <article class:list={['entry', { 'entry--flip': i % 2 === 1 }]}>
          <div class="entry__problem reveal">
            <code class="entry__prompt"><span class="p-user">$</span> problem</code>
            <h3>{p.problem}</h3>
            <p class="entry__desc">{p.description}</p>
          </div>

          <div class="entry__solution reveal">
            <div class="codebox">
              <div class="codebox__bar">
                <span>{p.codeLabel}</span>
                <span>{p.name}</span>
              </div>
              <pre class="codebox__body"><code set:html={highlight(p.code)} /></pre>
            </div>

            <div class="entry__meta">
              <code class="entry__stats">
                ★ {p.stars}{p.forks ? ` · ${p.forks} forks` : ''}{p.statsNote ? ` (${p.statsNote})` : ''}
              </code>
              <span class="entry__role">{p.role}</span>
              {p.credit && (
                <span class="entry__credit">
                  {p.credit} — <a href={p.creditUrl} target="_blank" rel="noopener">{p.creditUrl?.replace(/^https?:\/\//, '')}</a>
                </span>
              )}
            </div>

            <div class="entry__links">
              <a class="tlink" href={p.github} target="_blank" rel="noopener">
                <span>github</span><span class="arrow">↗</span>
              </a>
              {p.nuget && (
                <a class="tlink" href={p.nuget} target="_blank" rel="noopener">
                  <span>nuget</span><span class="arrow">↗</span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ============================ ABOUT ============================ -->
  <section class="about" id="about">
    <div class="wrap">
      <code class="about__head"><span class="p-user">gumbarros</span><span class="p-path">@portfolio:~$</span> whoami --verbose</code>
      <h2 class="reveal">An architect, not just a library author.</h2>
      <p class="reveal">
        I'm Gustavo Mauricio de Barros, a software architect at <a href="https://www.jjconsulting.com.br">JJConsulting</a>. My speciality
        is the .NET ecosystem. When I'm not shipping libraries, I travel, work out, cycle, and play
        piano.
      </p>
      <div class="about__tags reveal">
        <span class="tag">.NET</span>
        <span class="tag">C#</span>
        <span class="tag">Flutter</span>
        <span class="tag">Docker</span>
        <span class="tag">software architecture</span>
        <span class="tag">open source</span>
      </div>
    </div>
  </section>

  <!-- ============================ CONTACT ============================ -->
  <section class="contact" id="contact">
    <div class="wrap contact__inner">
      <div class="contact__text">
        <code class="contact__head"><span class="p-user">gumbarros</span><span class="p-path">@portfolio:~$</span> contact</code>
        <h2 class="reveal">Need a .NET architect or to use a tool? Both start the same way.</h2>
        <div class="contact__ctas reveal">
          <a class="btn btn--primary" href="https://www.linkedin.com/in/gumbarros" target="_blank" rel="noopener">
            <span>linkedin /in/gumbarros</span><span class="arrow">↗</span>
          </a>
          <a class="btn btn--ghost" href="https://github.com/gumbarros" target="_blank" rel="noopener">
            <span>github /gumbarros</span><span class="arrow">↗</span>
          </a>
        </div>
      </div>

      <figure class="contact__photo reveal">
        <div class="codebox__bar">
          <span>me.png</span>
        </div>
        <img class="avatar" src="/me.png" alt="Gustavo Mauricio de Barros" width="460" height="460" loading="lazy" />
      </figure>
    </div>
  </section>
</SiteLayout>

<script>
  // Hero type-in (one-shot, gated behind reduced-motion)
  const cmd = document.querySelector('[data-type]');
  if (cmd) {
    const full = cmd.dataset.type as string;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      cmd.textContent = full;
    } else {
      cmd.textContent = '';
      let i = 0;
      const tick = () => {
        cmd.textContent = full.slice(0, ++i);
        if (i < full.length) setTimeout(tick, 120);
      };
      setTimeout(tick, 400);
    }
  }
</script>
