---
import { locales, localeLabels, defaultLocale, type Locale } from '../i18n/ui';
import { getLocaleUrl, useTranslations } from '../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = useTranslations(locale);
const solutionUrl = 'https://github.com/gumbarros';
const hash = Astro.url.hash;

const links = [
  { id: 'solutions', label: t('nav.solutions') },
  { id: 'about', label: t('nav.about') },
  { id: 'contact', label: t('nav.contact') },
];
---

<nav class="nav">
  <div class="wrap nav__inner">
    <a class="nav__prompt" href={getLocaleUrl(locale, '/')}>
      <span class="p-user">gumbarros</span><span class="p-path">@portfolio:~$</span>
    </a>
    <div class="nav__flags">
      {links.map((l) => (
        <a class="nav__flag" href={`#${l.id}`} data-target={l.id}>
          {l.label}
        </a>
      ))}
      <a class="nav__flag" href={solutionUrl} target="_blank" rel="noopener">--github ↗</a>
      <label class="nav__lang">
        <span class="visually-hidden">{t('nav.language')}</span>
        <select
          aria-label={t('nav.language')}
          data-locale
          onchange="window.location.href = this.value"
        >
          {locales.map((l) => (
            <option
              value={`${getLocaleUrl(l, '/')}${hash}`}
              selected={l === locale}
            >
              {localeLabels[l]}
            </option>
          ))}
        </select>
      </label>
    </div>
  </div>
</nav>

<script>
  const flags = document.querySelectorAll<HTMLAnchorElement>('.nav__flag[data-target]');
  const targets = [...flags]
    .map((f) => document.getElementById(f.dataset.target ?? ''))
    .filter(Boolean) as HTMLElement[];

  const setActive = (id: string) => {
    flags.forEach((f) => f.classList.toggle('is-active', f.dataset.target === id));
  };

  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) setActive(e.target.id);
        }
      },
      { rootMargin: '-45% 0px -50% 0px', threshold: 0 }
    );
    targets.forEach((t) => io.observe(t));
  } else {
    setActive(targets[0]?.id ?? '');
  }

  // Persist the user's language choice so we stop auto-redirecting them.
  document.querySelectorAll<HTMLSelectElement>('[data-locale]').forEach((sel) => {
    sel.addEventListener('change', () => {
      try {
        localStorage.setItem('gumbarros-locale', sel.value);
      } catch (e) {
        /* ignore */
      }
    });
  });
</script>
