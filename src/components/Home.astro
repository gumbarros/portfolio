---
import SiteLayout from '../layouts/SiteLayout.astro';
import { solutions } from '../data/solutions';
import { solutionContent, type Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Merge the static solution shell with the localized content for this locale.
const localizedSolutions = solutions.map((p) => {
  const extra = solutionContent[locale][p.id] ?? solutionContent.en[p.id];
  return { ...p, ...extra };
});

const skillCategories = [
  { id: 'all', label: { en: 'all', 'pt-br': 'todas', es: 'todas' } },
  { id: 'frontend', label: { en: 'frontend', 'pt-br': 'frontend', es: 'frontend' } },
  { id: 'backend', label: { en: 'backend', 'pt-br': 'backend', es: 'backend' } },
  { id: 'mobile', label: { en: 'mobile', 'pt-br': 'mobile', es: 'móvil' } },
  { id: 'data', label: { en: 'data', 'pt-br': 'dados', es: 'datos' } },
  { id: 'devops', label: { en: 'devops / ci', 'pt-br': 'devops / ci', es: 'devops / ci' } },
  { id: 'architecture', label: { en: 'architecture', 'pt-br': 'arquitetura', es: 'arquitectura' } },
  { id: 'personal', label: { en: 'personal', 'pt-br': 'pessoal', es: 'personal' } },
] as const;

const skills = [
  { name: 'HTML / CSS', category: 'frontend', note: { en: 'semantic UI', 'pt-br': 'UI semântica', es: 'UI semántica' } },
  { name: 'JavaScript', category: 'frontend', note: { en: 'web platform', 'pt-br': 'plataforma web', es: 'plataforma web' } },
  { name: 'Astro', category: 'frontend', note: { en: 'this portfolio', 'pt-br': 'este portfólio', es: 'este portafolio' } },
  { name: 'C# / .NET', category: 'backend', note: { en: 'daily driver', 'pt-br': 'ferramenta principal', es: 'herramienta principal' } },
  { name: 'ASP.NET Core', category: 'backend', note: { en: 'production APIs', 'pt-br': 'APIs em produção', es: 'APIs en producción' } },
  { name: 'Node.js', category: 'backend', note: { en: 'JavaScript runtime', 'pt-br': 'runtime JavaScript', es: 'runtime JavaScript' } },
  { name: 'FastAPI', category: 'backend', note: { en: 'fast Python APIs', 'pt-br': 'APIs Python rápidas', es: 'APIs Python rápidas' } },
  { name: 'F#', category: 'backend', note: { en: 'functional .NET', 'pt-br': '.NET funcional', es: '.NET funcional' } },
  { name: 'Flutter', category: 'mobile', note: { en: 'cross-platform', 'pt-br': 'multiplataforma', es: 'multiplataforma' } },
  { name: 'Kotlin', category: 'mobile', note: { en: 'Android & multiplatform', 'pt-br': 'Android e multiplataforma', es: 'Android y multiplataforma' } },
  { name: 'SQL Server', category: 'data', note: { en: 'relational', 'pt-br': 'relacional', es: 'relacional' } },
  { name: 'MySQL', category: 'data', note: { en: 'relational', 'pt-br': 'relacional', es: 'relacional' } },
  { name: 'MongoDB', category: 'data', note: { en: 'document store', 'pt-br': 'banco de documentos', es: 'base de documentos' } },
  { name: 'GitLab CI', category: 'devops', note: { en: 'pipelines', 'pt-br': 'pipelines', es: 'pipelines' } },
  { name: 'GitHub Actions', category: 'devops', note: { en: 'automation', 'pt-br': 'automação', es: 'automatización' } },
  { name: 'Microservices', category: 'architecture', note: { en: 'distributed systems', 'pt-br': 'sistemas distribuídos', es: 'sistemas distribuidos' } },
  { name: 'Domain-Driven Design', category: 'architecture', note: { en: 'bounded contexts', 'pt-br': 'contextos delimitados', es: 'contextos delimitados' } },
  { name: 'Software Architecture', category: 'architecture', note: { en: 'systems thinking', 'pt-br': 'visão sistêmica', es: 'visión sistémica' } },
  { name: 'Strangler Fig', category: 'architecture', note: { en: 'gradual modernization', 'pt-br': 'modernização gradual', es: 'modernización gradual' } },
  { name: 'Modular Monolith', category: 'architecture', note: { en: 'structured simplicity', 'pt-br': 'simplicidade estruturada', es: 'simplicidad estructurada' } },
  { name: 'Open Source', category: 'personal', note: { en: 'github.com/gumbarros', 'pt-br': 'github.com/gumbarros', es: 'github.com/gumbarros' } },
  { name: 'Design Thinking', category: 'personal', note: { en: 'human-centered', 'pt-br': 'foco nas pessoas', es: 'centrado en las personas' } },
  { name: 'People Management', category: 'personal', note: { en: 'team leadership', 'pt-br': 'liderança de equipes', es: 'liderazgo de equipos' } },
] as const;

const skillsCopy = {
  en: { cmd: 'ls ./capabilities/ --group-by category', title: 'Tools I reach for', hint: 'filter by where the work happens' },
  'pt-br': { cmd: 'ls ./capacidades/ --group-by categoria', title: 'Ferramentas que uso', hint: 'filtre por onde o trabalho acontece' },
  es: { cmd: 'ls ./capacidades/ --group-by categoria', title: 'Herramientas que uso', hint: 'filtra por dónde ocurre el trabajo' },
} as const;

// Naive terminal highlighting: mute comment lines; wrap a leading keyword.
function highlight(src: string): string {
  return src
    .split('\n')
    .map((line) => {
      const trimmed = line.trimStart();
      if (trimmed.startsWith('//')) {
        return `<span class="c">${line}</span>`;
      }
      const m = trimmed.match(/^(var|await|IStore|builder|using|new|$color)\b/);
      if (m) {
        const kw = m[0];
        const idx = line.indexOf(kw);
        return `${line.slice(0, idx)}<span class="k">${kw}</span>${line.slice(idx + kw.length)}`;
      }
      return line;
    })
    .join('\n');
}
---

<SiteLayout locale={locale}>
  <!-- ============================ HERO ============================ -->
  <header class="hero" id="top">
    <div class="wrap hero__inner">
      <code class="hero__cmd">
        <span class="p-user">gumbarros</span><span class="p-path">@portfolio:~$</span>
        <span data-type="whoami"></span><span class="cursor" aria-hidden="true"></span>
      </code>
      <h1 class="hero__title" set:html={t('hero.title')} />
      <p class="hero__lede" set:html={t('hero.lede')} />
      <div class="hero__ctas">
        <a class="btn btn--primary" href="#contact">
          <span>{t('hero.contact')}</span><span class="arrow">→</span>
        </a>
      </div>
    </div>
  </header>

  <!-- ============================ SOLUTIONS ============================ -->
  <section class="ledger" id="solutions">
    <div class="wrap ledger__head reveal">
      <code class="cmd">gumbarros@portfolio:~$ ls ./problems/ · {t('solutions.entries')(localizedSolutions.length)}</code>
      <h2>{t('solutions.headline')}</h2>
    </div>

    <div class="wrap ledger__list">
      {localizedSolutions.map((p, i) => (
        <article class:list={['entry', { 'entry--flip': i % 2 === 1 }]}>
          <div class="entry__problem reveal">
            <code class="entry__prompt"><span class="p-user">$</span> {t('solutions.prompt')}</code>
            <h3>{p.problem}</h3>
            <p class="entry__desc">{p.description}</p>
          </div>

          <div class="entry__solution reveal">
            <div class="codebox">
              <div class="codebox__bar">
                <span>{p.codeLabel}</span>
                <span>{p.name}</span>
              </div>
              <pre class="codebox__body"><code set:html={highlight(p.code)} /></pre>
            </div>

            <div class="entry__meta">
              <code class="entry__stats">
                ★ {p.stars}{p.forks ? ` · ${p.forks} forks` : ''}{p.statsNote ? ` (${p.statsNote})` : ''}
              </code>
              <span class="entry__role">{p.role}</span>
              {p.credit && (
                <span class="entry__credit">
                  {p.credit} · <a href={p.creditUrl} target="_blank" rel="noopener">{p.creditUrl?.replace(/^https?:\/\//, '')}</a>
                </span>
              )}
            </div>

            <div class="entry__links">
              {p.moreUrl && (
                <a class="btn btn--primary" href={p.moreUrl} target="_blank" rel="noopener">
                  <span>{t('solutions.viewMore')}</span><span class="arrow">↗</span>
                </a>
              )}
              <a class="tlink" href={p.github} target="_blank" rel="noopener">
                <span>github</span><span class="arrow">↗</span>
              </a>
              {p.nuget && (
                <a class="tlink" href={p.nuget} target="_blank" rel="noopener">
                  <span>nuget</span><span class="arrow">↗</span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ============================ ABOUT ============================ -->
  <section class="about" id="about">
    <div class="wrap">
      <code class="about__head"><span class="p-user">gumbarros</span><span class="p-path">@portfolio:~$</span> {t('about.cmd')}</code>
      <h2 class="reveal">{t('about.headline')}</h2>
      <div class="about__story reveal">
        <p class="about__lead" set:html={t('about.body')} />
      </div>

      <div class="about__lower">
        <div class="career-terminal reveal">
          <div class="career-terminal__bar">
            <span><i></i><i></i><i></i></span>
            <code>/var/log/gumbarros</code>
            <span class="career-terminal__status">● {t('about.status')}</span>
          </div>
          <div class="career-terminal__body">
            <code class="career-terminal__command"><span class="p-user">$</span> cat /var/log/gumbarros</code>
            <div class="career-terminal__events">
              {(t('about.events') as readonly { year: string; text: string }[]).map((event) => (
                <div class="career-event">
                  <span class="career-event__year">[{event.year}]</span>
                  <span>{event.text}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <section class="capabilities reveal" aria-labelledby="capabilities-title">
          <div class="capabilities__head">
            <div>
              <code class="capabilities__cmd"><span class="p-user">gumbarros</span><span class="p-path">@portfolio:~$</span> {skillsCopy[locale].cmd}</code>
              <h3 id="capabilities-title">{skillsCopy[locale].title}</h3>
            </div>
            <p>{skillsCopy[locale].hint}</p>
          </div>

          <div class="capabilities__filters" role="group" aria-label="Filter skills">
            {skillCategories.map((category, index) => (
              <button class:list={['capability-filter', { 'is-active': index === 0 }]} type="button" data-filter={category.id} aria-pressed={index === 0 ? 'true' : 'false'}>
                <span class="capability-filter__mark">{index === 0 ? '*' : '+'}</span>{category.label[locale]}
              </button>
            ))}
          </div>

          <div class="capabilities__grid">
            {skills.map((skill) => (
              <article class={`skill-badge skill-badge--${skill.category}`} data-category={skill.category}>
                <span class="skill-badge__dot" aria-hidden="true"></span>
                <strong>{skill.name}</strong>
                <small>{skill.note[locale]}</small>
              </article>
            ))}
          </div>
        </section>

      </div>
    </div>
  </section>

  <!-- ============================ CONTACT ============================ -->
  <section class="contact" id="contact">
    <div class="wrap contact__inner">
      <div class="contact__text">
        <code class="contact__head"><span class="p-user">gumbarros</span><span class="p-path">@portfolio:~$</span> {t('contact.cmd')}</code>
        <h2 class="reveal">{t('contact.headline')}</h2>
        <div class="contact__ctas reveal">
          <a class="btn btn--primary" href="https://www.linkedin.com/in/gumbarros" target="_blank" rel="noopener">
            <span>{t('contact.linkedin')}</span><span class="arrow">↗</span>
          </a>
          <a class="btn btn--ghost" href="https://github.com/gumbarros" target="_blank" rel="noopener">
            <span>{t('contact.github')}</span><span class="arrow">↗</span>
          </a>
        </div>
      </div>

      <figure class="contact__photo reveal">
        <div class="codebox__bar">
          <span>{t('contact.photo')}</span>
        </div>
        <img class="avatar" src="/me.png" alt="Gustavo Mauricio de Barros" width="460" height="460" loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>
</SiteLayout>

<script>
  // Hero type-in (one-shot, gated behind reduced-motion)
  const cmd = document.querySelector<HTMLElement>('[data-type]');
  if (cmd) {
    const full = cmd.dataset.type as string;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      cmd.textContent = full;
    } else {
      cmd.textContent = '';
      let i = 0;
      const tick = () => {
        cmd.textContent = full.slice(0, ++i);
        if (i < full.length) setTimeout(tick, 120);
      };
      setTimeout(tick, 400);
    }
  }
</script>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const badges = document.querySelectorAll<HTMLElement>('[data-category]');

  filters.forEach((filter) => {
    filter.addEventListener('click', () => {
      const selected = filter.dataset.filter;
      filters.forEach((item) => {
        const active = item === filter;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      badges.forEach((badge) => {
        badge.hidden = selected !== 'all' && badge.dataset.category !== selected;
      });
    });
  });
</script>
