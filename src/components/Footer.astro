---
const productUrl = 'https://github.com/gumbarros';
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__brand"><span class="p-user">gumbarros</span> — Gustavo Mauricio de Barros</div>
    <div class="footer__lines">
      <div>Built from 🇧🇷</div>
      <div>Not vibe-coded, but thought by a human and written by a machine.</div>
    </div>
    <div class="footer__meta">
      <a href="/#products">--products</a>
      <a href="/#about">--about</a>
      <a href="/#contact">--contact</a>
      <a href={productUrl} target="_blank" rel="noopener">--github</a>
      <span>© 2026</span>
    </div>
  </div>
</footer>
