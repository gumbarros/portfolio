---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { defaultLocale, type Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = useTranslations(locale);
const title = Astro.props.title ?? t('meta.title');
const description = Astro.props.description ?? t('meta.description');

// Single-page portfolio: every locale variant is a language mirror of the same
// content, so canonical + hreflang alternates point across the three locale roots.
const site = Astro.site ?? new URL('https://gumbarros.com.br');
const canonical = new URL(Astro.url.pathname, site).href;

const localeRoots: Record<Locale, string> = { en: '/', 'pt-br': '/pt-br/', es: '/es/' };
const alternates = Object.entries(localeRoots).map(([hrefLang, path]) => ({
  hrefLang,
  href: new URL(path, site).href,
}));

const ogLocales: Record<Locale, string> = { en: 'en_US', 'pt-br': 'pt_BR', es: 'es_ES' };
const ogImage = new URL('/me.png', site).href;
---

<BaseLayout
  title={title}
  description={description}
  lang={locale}
  canonical={canonical}
  alternates={alternates}
  ogLocale={ogLocales[locale]}
  image={ogImage}
>
  <Nav locale={locale} />
  <main>
    <slot />
  </main>
  <Footer locale={locale} />

  <script>
    if (typeof document !== 'undefined') {
      document.documentElement.classList.add('js');
    }

    // Reveal on scroll (shared across pages)
    const els = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15 }
      );
      els.forEach((el) => io.observe(el));
    } else {
      els.forEach((el) => el.classList.add('is-in'));
    }
  </script>
</BaseLayout>
